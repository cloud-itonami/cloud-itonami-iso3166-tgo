(ns statute.facts-test
  (:require [kotoba.lang.text :as str]
            [kotoba.test :refer [deftest is]]
            [statute.facts :as facts]))

(deftest tgo-has-spec-basis
  (let [sb (facts/spec-basis "TGO")]
    (is (= 3 (count sb)))
    (is (every? #(str/starts-with? (:statute/url %) "https://") sb))
    (is (every? :statute/law-number sb))))

(deftest unknown-jurisdiction-has-no-spec-basis
  (is (nil? (facts/spec-basis "ATL")))
  (is (nil? (facts/spec-basis "ZZZ"))))

(deftest coverage-is-honest
  (let [c (facts/coverage ["TGO" "JPN" "ATL"])]
    (is (= 3 (:requested c)))
    (is (= 1 (:covered c)))
    (is (= ["ATL" "JPN"] (:missing-jurisdictions c)))))

(deftest by-topic-filters
  (is (= ["tgo.code-investissements"]
         (mapv :statute/id (facts/by-topic "TGO" :investment))))
  (is (= ["tgo.otr-creation"]
         (mapv :statute/id (facts/by-topic "TGO" :tax))))
  (is (empty? (facts/by-topic "TGO" :environment)))
  (is (empty? (facts/by-topic "ATL" :investment))))
